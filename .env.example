# Copy to .env.local for local overrides. Every VITE_ value is baked into the
# public bundle at build time, so never put a secret here.

# Dev server only: backend origin that /api is proxied to; empty means http://localhost:8000.
# vite.config.js reads this one from the shell environment, not from this file.
VITE_API_URL=

# Google OAuth web client ID (register <origin>/auth/google/callback); empty disables Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra ID application client ID (register <origin>/auth/microsoft/callback); empty disables it.
VITE_MICROSOFT_CLIENT_ID=

# Set to false to hide enterprise single sign-on (mirrors the API's ORG_FEATURES_ENABLED); empty leaves it on.
VITE_ORG_FEATURES_ENABLED=

# Cookiebot domain group ID for the consent banner and cookie declaration; empty means no banner.
VITE_COOKIEBOT_CBID=

# Origin of the feedback service; empty hides the in-app Help and feedback button.
VITE_FEEDBACK_API_URL=

# Base URL for large static assets such as the onboarding videos; empty serves them from this origin.
VITE_ASSET_CDN=
